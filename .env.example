# Copy to .env. Docker Compose reads it, and so does the API when run locally
# (`make dev-api`). No AI provider keys belong here: each user adds their own
# key in the app (Overview page or API Keys).

# --- PostgreSQL (the `db` service in compose.yaml) ---------------------------
POSTGRES_DB=chief_of_staff
POSTGRES_USER=chief_of_staff
POSTGRES_PASSWORD=chief_of_staff_dev
POSTGRES_PORT=5433

# Database for the API. With `docker compose up -d db`, a locally run API connects
# through the published port. Inside Compose the API gets its own DATABASE_URL
# pointing at the `db` service. Leave empty to use SQLite at data/app.db.
DATABASE_URL=postgresql://chief_of_staff:chief_of_staff_dev@127.0.0.1:5433/chief_of_staff

# --- Secrets encryption -------------------------------------------------------
# Fernet key that encrypts users' stored API keys and SMTP passwords. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, a key is generated once at APP_KEY_FILE (default data/.app_encryption_key).
# Keep it: losing the key makes saved API keys unreadable.
APP_ENCRYPTION_KEY=

# --- Misc ---------------------------------------------------------------------
# SQLite file used only when DATABASE_URL is empty.
APP_DB_PATH=
# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional worker-only key material; never set this for the API service.
TOKEN_VAULT_PRIVATE_KEY=
